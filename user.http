#Thêm user
POST http://localhost:3001/api/users
Content-Type: application/json

{
    "name": "User2",
    "email": "user2@example.com",
    "age": 18
}
###
// Lấy danh sách user
GET http://localhost:3001/api/users
###
// Lấy user theo id
GET http://localhost:3001/api/users/6a6b437c9ce982033cd76a63
###
// Cập nhật user
PUT http://localhost:3001/api/users/6a6b3fc79ce982033cd76a61
Content-Type: application/json

{
    "name": "User1",
    "email": "user1@example.com",
    "age": 19
}
###
// Xóa user
DELETE http://localhost:3001/api/users/6a6b3fc79ce982033cd76a61
